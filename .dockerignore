# ──────────────────────────────────────────────────────────────────
# Root .dockerignore  (build context is always the repo root)
# Keeps the build context small and prevents secrets leaking into
# any image built from this repo.
# ──────────────────────────────────────────────────────────────────

# Node dependencies — re-installed inside each image
node_modules
**/node_modules

# Compiled output
**/dist
**/build

# Test coverage reports
**/coverage

# Environment files — values are injected by docker-compose at runtime
**/.env
**/.env.local
**/.env.*.local
# Allow .env.example so Dockerfiles can copy it as a template
!**/.env.example

# TypeScript incremental build info
**/*.tsbuildinfo

# Logs
**/*.log
**/npm-debug.log*

# Git internals
.git
.gitignore
.husky

# IDE / OS noise
.vscode
.idea
.DS_Store
Thumbs.db

# Project docs (not needed at runtime)
docs
README.md
